#include "imx6qdl-var-som.dtsi"

/ {
	model = "Shaper Origin Gen 1 (SO1) / Coltrane";
	compatible = "variscite,var-som-imx6q", "fsl,imx6q";

	/* 24V Power from AC/DC on Coltrane Power Board */
	reg_vsys_24v0: regulator-vsys-24v0 {
		regulator-name = "VSYS_24V0";
		compatible = "regulator-fixed";
		regulator-max-microvolt = <24000000>;
		regulator-min-microvolt = <24000000>;
		regulator-boot-on;
		regulator-always-on;
	};

	/* 5V Power from SMPS on Coltrane Power Board */
	reg_vsys_5v0: regulator-vsys-5v0 {
		regulator-name = "VSYS_5V0";
		compatible = "regulator-fixed";
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-boot-on;
		regulator-always-on;
        	vin-supply = <&reg_vsys_24v0>;
	};

	/* 3.3V Power from SMPS on Coltrane Power Board */
	reg_vsys_3v3: regulator-vsys-3v3 {
		regulator-name = "VSYS_3V3";
		compatible = "regulator-fixed";
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
        	vin-supply = <&reg_vsys_24v0>;
	};

	/* 1.8V Camera DOVDD Power Supply generated by dedicated LDO from 3.3V VSYS on Vision Board */
	reg_vcam_1v8: regulator-vcam-1v8 {
		regulator-name = "VCAM_1V8";
		compatible = "regulator-fixed";
		regulator-max-microvolt = <1800000>;
		regulator-min-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
        	vin-supply = <&reg_vsys_3v3>;
	};

	/* 2.8V Camera AVDD Power Supply generated by dedicated LDO from 3.3V VSYS on Vision Board */
	reg_vcam_2v8: regulator-vcam-2v8 {
		regulator-name = "VCAM_2V8";
		compatible = "regulator-fixed";
		regulator-max-microvolt = <2800000>;
		regulator-min-microvolt = <2800000>;
		regulator-boot-on;
		regulator-always-on;
        	vin-supply = <&reg_vsys_3v3>;
	};

    	/* 1.5V Camera DVDD Internally Generated Core Power */
	reg_vcam_internal_1v5: regulator-vcam-internal-1v5 {
		regulator-name = "VCAM_INTERNAL_1V5";
		compatible = "regulator-fixed";
		regulator-max-microvolt = <1500000>;
		regulator-min-microvolt = <1500000>;
		regulator-boot-on;
		regulator-always-on;
        	vin-supply = <&reg_vcam_2v8>;
	};

	/* The Backlight supply is sourced from the System 24V rail from power board */
	backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm2 0 50000 0>;
		brightness-levels = <0 4 8 16 32 64 128 248>;
		default-brightness-level = <0>;
		status = "okay";
		power-supply = <&reg_vsys_24v0>;
	};

        reserved-memory {
                #address-cells = <1>;
                #size-cells = <1>;
                ranges;

                ramoops@7fff0000 {
                    compatible = "ramoops";
                    no-map;
                    console-size = <0x8000>;    /* 32kB */
                    record-size = <0x400>;      /*  1kB */
                    reg = <0x7fff0000 0x10000>; /* 64kB */
                };

                /* global autoconfigured region for contiguous allocations */
                linux,cma {
                        compatible = "shared-dma-pool";
                        reusable;
                        size = <0x10000000>;
                        //size = <0x14000000>;
                        linux,cma-default;
                };
        };

	/* This is the seperate Kernel interrupt that we use to log overcurrent events on USB Host */
	/* See Comments below */
	usbh1_oc_alert {
		compatible = "shaper,usbh1-oc-alert";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_usbh1_oc_alert_var>;
		gpios = <&gpio3 30 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

/* Overrides to i.MX6Q Operating Points, as utilized by Variscite */
&cpu0 {
	operating-points = <
		/* kHz    uV */
		1200000	1350000
		996000	1250000
		852000	1250000
		792000	1175000
		396000	1175000
	>;

	fsl,soc-operating-points = <
		/* ARM kHz  SOC-PU uV */
		1200000	1275000
		996000	1250000
		852000	1250000
		792000	1250000
		396000	1250000
	>;
};
&cpu1 {
	operating-points = <
		/* kHz    uV */
		1200000	1350000
		996000	1250000
		852000	1250000
		792000	1175000
		396000	1175000
	>;

	fsl,soc-operating-points = <
		/* ARM kHz  SOC-PU uV */
		1200000	1275000
		996000	1250000
		852000	1250000
		792000	1250000
		396000	1250000
	>;
};
&cpu2 {
	operating-points = <
		/* kHz    uV */
		1200000	1350000
		996000	1250000
		852000	1250000
		792000	1175000
		396000	1175000
	>;

	fsl,soc-operating-points = <
		/* ARM kHz  SOC-PU uV */
		1200000	1275000
		996000	1250000
		852000	1250000
		792000	1250000
		396000	1250000
	>;
};
&cpu3 {
	operating-points = <
		/* kHz    uV */
		1200000	1350000
		996000	1250000
		852000	1250000
		792000	1175000
		396000	1175000
	>;

	fsl,soc-operating-points = <
		/* ARM kHz  SOC-PU uV */
		1200000	1275000
		996000	1250000
		852000	1250000
		792000	1250000
		396000	1250000
	>;
};

/*
 * We disable native USB driver overcurrent detection via OC mode or GPIO mode.
 * We instead monitor the relevant OC pin as a normal interrupt because we want the
 * USB power chip to handle it directly without interference from the SoC.
 * If we don't disable it, then the boot logs complain about the polarity being unset
 * If we DO enable it, then an OC event causes the SoC to disable the USB PHY without ever re-enabling it.
 * See Comment on pinctrl_usbh1_var.
*/
&usbh1 {
	disable-over-current;
	/* pinctrl-names = "default"; */
	/* pinctrl-0 = <&pinctrl_usbh1_var>; */
	/* over-current-active-low; */

	/* Only if we configure for GPIO mode in pinctrl_usbh1_var */
	/* over-current-gpios = <&gpio3 30 GPIO_ACTIVE_LOW>; */
};

/* The following regulator sources should really be in the imx6qdl-var-som.dtsi file because they are a function of the PMIC. */
/* But, we want to use the upstream file from Variscite for the SOM DTSI, so we define them here. */
/* See Figure 10-5. i.MX 6Dual/6Quad Power Tree in i.MX6 Reference Manual */
&reg_usb_h1_vbus {
	/* USB Host 1 Supply is provided by 5V VSYS via OC Switch */
	vin-supply = <&reg_vsys_5v0>;
	regulator-boot-on;
};
&reg_3p3v {
	/* The 3.3V supply on the SOM is fed in from the 3.3V VSYS. */
	vin-supply = <&reg_vsys_3v3>;
	regulator-boot-on;
};
&reg_1p8v {
	/* The 1.8V supply on the SOM is derived from the 3.3V VSYS via PMIC */
	/* Per SW-8715 notes we've determined that the system 1.8V rail is PMIC VGEN4. */
	/* To-Do: assign downstream consumers to VGEN4 instead of this dummy. */
	vin-supply = <&reg_3p3v>;
	regulator-boot-on;
};

/* Presume that all PMIC rails are effectively generated from the 3.3V Supply fed to the SOM */
&sw1a_reg {
	vin-supply = <&reg_3p3v>;
};
&sw1c_reg {
	vin-supply = <&reg_3p3v>;
};
&sw2_reg {
	vin-supply = <&reg_3p3v>;
};
&sw3a_reg {
	vin-supply = <&reg_3p3v>;
};
&sw3b_reg {
	vin-supply = <&reg_3p3v>;
};
&sw4_reg {
	vin-supply = <&reg_3p3v>;
};
&snvs_reg {
	vin-supply = <&reg_3p3v>;
};
&vref_reg {
	vin-supply = <&reg_3p3v>;
};
&vgen1_reg {
	vin-supply = <&reg_3p3v>;
};
&vgen2_reg {
	vin-supply = <&reg_3p3v>;
};
&vgen3_reg {
	vin-supply = <&reg_3p3v>;
};
&vgen4_reg {
	/* Confirmed vai probing (SW-8715) that this is the actual 1.8V rail used on the SOM */
	vin-supply = <&reg_3p3v>;
};
&vgen5_reg {
	vin-supply = <&reg_3p3v>;
};
&vgen6_reg {
	vin-supply = <&reg_3p3v>;
};

/* anatop requires the following regulators to exist */
/* These regulators are inside the SoC */
&reg_arm {
	regulator-boot-on;
	regulator-always-on;
	regulator-allow-bypass;
};

&reg_soc {
	regulator-boot-on;
	regulator-always-on;
	regulator-allow-bypass;
};

&reg_pu {
	regulator-boot-on;
	regulator-always-on;
	regulator-allow-bypass;
};

&reg_vdd1p1 {
	regulator-boot-on;
	regulator-always-on;
};

&reg_vdd2p5 {
	regulator-boot-on;
	regulator-always-on;
};

&reg_vdd3p0 {
	/* Actual Supply is not certain - setting to SOM input supply */
	vin-supply = <&reg_3p3v>;
	regulator-boot-on;
	regulator-always-on;
};
/* end anatop regulators */

&ldb {
	status = "okay";

	lvds-channel@0 {
		fsl,data-mapping = "spwg";
		fsl,data-width = <24>;
		status = "okay";
		primary;

		display-timings {
			native-mode = <&timing0c>;
			timing0c: hsd100pxn1 {
				clock-frequency = <31000000>;
				hactive = <800>;
				vactive = <480>;
				hback-porch = <88>;
				hfront-porch = <40>;
				hsync-len = <48>;
				vback-porch = <32>;
				vfront-porch = <13>;
				vsync-len = <3>;
			};
		};
	};
};

&ecspi1 {
    fsl,spi-num-chipselects = <1>;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_ecspi1_2>;
    cs-gpios = <&gpio4 9 GPIO_ACTIVE_HIGH>;
    status = "okay";

    stm32: mcu-spi@0 {
        compatible = "shapertools,mcu-spi";
        spi-max-frequency = <50000000>;
        mcu-reset-gpios = <&gpio6 1 GPIO_OPEN_DRAIN>;
        mcu-boot-gpios = <&gpio6 3 GPIO_OPEN_DRAIN>;
        mcu-int-gpios = <&gpio6 4 GPIO_ACTIVE_LOW>;
        mcu-ready-gpios = <&gpio5 19 GPIO_ACTIVE_LOW>;
        mcu-board-id-gpios = <&gpio5 13 GPIO_ACTIVE_LOW>,<&gpio5 16 GPIO_ACTIVE_LOW>,<&gpio5 15 GPIO_ACTIVE_LOW>;
        reg = <0>;
    };
};

&i2c1 {
    clock-frequency = <100000>;
    status = "okay";

    pinctrl-names = "default", "gpio";
    pinctrl-0 = <&pinctrl_i2c1>;
    pinctrl-1 = <&pinctrl_i2c1_recovery>;
    scl-gpios = <&gpio5 27 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
    sda-gpios = <&gpio5 26 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;

    ov7251_mipi: camera@60 {
		compatible = "ovti,ov7251";
		reg = <0x60>;
		clocks = <&clks IMX6QDL_CLK_CKO2>;
		clock-names = "xclk";
		clock-frequency = <24000000>;
		vdddo-supply = <&reg_vcam_1v8>; /* I/O Voltage Supply (1.8V) */
		vdda-supply = <&reg_vcam_2v8>; /* Analog Voltage Supply (2.8V) */
		vddd-supply = <&reg_vcam_internal_1v5>; /* Core Voltage Supply (Internal 1.5V) */
		enable-gpios = <&gpio4 10 GPIO_ACTIVE_HIGH>;
	
		port {
			ov7251_ep: endpoint {
				remote-endpoint = <&mipi_csi2_in>;
				clock-lanes = <1>;
				data-lanes = <0>;
				link-frequencies = /bits/ 64 <240000000 319200000>;
			};
		};
	};
};

&i2c2 {
    pinctrl-names = "default", "gpio";
    scl-gpios = <&gpio4 12 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
    sda-gpios = <&gpio4 13 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
    pinctrl-0 = <&pinctrl_i2c2>;
    pinctrl-1 = <&pinctrl_i2c2_recovery>;
};

&i2c3 {
    clock-frequency = <100000>;
    status = "okay";

    pinctrl-names = "default", "gpio";
    pinctrl-0 = <&pinctrl_i2c3>;
    pinctrl-1 = <&pinctrl_i2c3_recovery>;
    scl-gpios = <&gpio1 5 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
    sda-gpios = <&gpio7 11 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;

    /* PCF8523 RTC module */
    rtc@68 {
        compatible = "nxp,pcf8523";
        reg = <0x68>;
    };

    /* Touch */
    ctw6120_tsc@38 {
        compatible = "edt,edt-ft5206";
        reg = <0x38>;
        interrupt-parent = <&gpio6>;
        interrupts = <0 0>;
        reset-gpios = <&gpio6 2 GPIO_ACTIVE_LOW>;
        touchscreen-x-mm = <108>;
        touchscreen-y-mm = <65>;
        touchscreen-size-y = <480>;
        touchscreen-size-x = <800>;
	vcc-supply = <&reg_3p3v>;
	iovcc-supply = <&reg_1p8v>;
    };
};

&mipi_csi {
        status = "okay";

        port@0 {
                reg = <0>;

                mipi_csi2_in: endpoint {
                        remote-endpoint = <&ov7251_ep>;
                        clock-lanes = <1>;
                        data-lanes = <0>;
                };
        };
};

&iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>;

	pinctrl_ecspi1_1: ecspi1grp-1 {
		fsl,pins = <
		MX6QDL_PAD_EIM_D17__ECSPI1_MISO 0x100b1
		MX6QDL_PAD_EIM_D18__ECSPI1_MOSI 0x100b1
		MX6QDL_PAD_EIM_D16__ECSPI1_SCLK 0x100b1
		>;
	};

	pinctrl_ecspi1_2: ecspi1grp-2 {
		fsl,pins = <
		MX6QDL_PAD_KEY_COL1__ECSPI1_MISO 0x100b1
		MX6QDL_PAD_KEY_ROW0__ECSPI1_MOSI 0x100b1
		MX6QDL_PAD_KEY_COL0__ECSPI1_SCLK 0x100b1
		>;
	};

	/* Camera Control */
	pinctrl_ov7251: ov7251grp {
		fsl,pins = <
		/* CAMERA.CLK */
		MX6QDL_PAD_GPIO_3__CCM_CLKO2        0x130b0
		/* CAMERA.EN */
		MX6QDL_PAD_KEY_COL2__GPIO4_IO10     0x130b0
		/* CAMERA.LED_PWM */
		MX6QDL_PAD_GPIO_9__PWM1_OUT         0x130b1
		>;
	};

	/* MCU RX on UART3 for Debug Logs*/
	pinctrl_uart3: uart3grp {	/* RX/TX RTS/CTS */
		fsl,pins = <
			MX6QDL_PAD_EIM_D25__UART3_RX_DATA	0x1b0b1
			MX6QDL_PAD_EIM_D24__UART3_TX_DATA	0x1b0b1
			MX6QDL_PAD_EIM_D23__UART3_CTS_B		0x1b0b1
			MX6QDL_PAD_EIM_EB3__UART3_RTS_B		0x1b0b1
		>;
	};

	/* Driver DOES support native USB_H1_OC mode, which raises an observable interrupt in the kernel.
	 * However, when it recevies this interupt, it also disables the USB PHY and doesn't re-enable it.
	 * We don't want that behavior, since the Diodes AP2151D USB Power switch chip is already autonomously
	 * pulling power to the USB port when it detects an overcurrent condition. We want that chip to just automatically
	 * re-assert power when the overcurrent condition is removed. Still, it is useful to KNOW that this happened,
	 * so, we configure the pin in the GPIO Mux mode instead of the native OC mode and raise a flag up to the kernel for our logs.
	 * We don't bother configuring the Power enable line (GPIO2_11), since we don't want the SoC to control it anyways.
	 * MX6QDL_PAD_EIM_D30__USB_H1_OC	0x1b0b1 // Native Mode
	 * MX6QDL_PAD_EIM_D30__GPIO3_IO30 	0x1b0b1 // GPIO Mode
	 * 0x1b0b1 = HYS | 100K_UP | PUE | PKE | SPEED_MED | DSE_40ohm | FAST_SLEW
	 */
	/* pinctrl_usbh1_var: usbh1grp {
	 * 	fsl,pins = <
	 *		MX6QDL_PAD_EIM_D30__USB_H1_OC	0x1b0b1
	 *	>;
	 * };
	 */

	pinctrl_usbh1_oc_alert_var: usbh1ocalertgrp {
		fsl,pins = <
			/* GPIO3_IO30 as input, HYS | PUE | PKE | 100k_UP | MED speed | 40ohm */
			MX6QDL_PAD_EIM_D30__GPIO3_IO30 		0x1b0b0
		>;
	};

	pinctrl_usbotg_var: usbotggrp {
		fsl,pins = <
			MX6QDL_PAD_GPIO_4__GPIO1_IO04		0x17059
		>;
	};

	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			MX6QDL_PAD_SD1_CMD__SD1_CMD		0x17071
			MX6QDL_PAD_SD1_CLK__SD1_CLK		0x10071
			MX6QDL_PAD_SD1_DAT0__SD1_DATA0		0x17071
			MX6QDL_PAD_SD1_DAT1__SD1_DATA1		0x17071
			MX6QDL_PAD_SD1_DAT2__SD1_DATA2		0x17071
			MX6QDL_PAD_SD1_DAT3__SD1_DATA3		0x17071
		>;
	};

	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <
			MX6QDL_PAD_SD2_CMD__SD2_CMD		0x17059
			MX6QDL_PAD_SD2_CLK__SD2_CLK		0x10059
			MX6QDL_PAD_SD2_DAT0__SD2_DATA0		0x17059
			MX6QDL_PAD_SD2_DAT1__SD2_DATA1		0x17059
			MX6QDL_PAD_SD2_DAT2__SD2_DATA2		0x17059
			MX6QDL_PAD_SD2_DAT3__SD2_DATA3		0x17059
		>;
	};

	/*
	 * pinctrl_i2cx originally configured in ./arch/arm/boot/dts/nxp/imx/imx6qdl-var-som.dtsi
	 * Redefined to clearly show changes to DSE field when operated in GPIO mode for recovery
	 # i2c mode can also operate at lower drive strength, but we did not observe meaningful differences
	 * i2c mode:  DSE 0b110 (40_OHM — 25 Ohm @ 3.3V, 40 Ohm @ 1.8V) 0x4001b8b1
	 * gpio mode: DSE 0b011 (90_OHM — 50 Ohm @ 3.3V, 90 Ohm @ 1.8V) 0x4001b899
	 */

        pinctrl_i2c1: i2c1grp {
                fsl,pins = <
                        MX6QDL_PAD_CSI0_DAT9__I2C1_SCL	0x4001b8b1
                        MX6QDL_PAD_CSI0_DAT8__I2C1_SDA	0x4001b8b1
                >;
        };

        pinctrl_i2c2: i2c2grp {
                fsl,pins = <
                        MX6QDL_PAD_KEY_COL3__I2C2_SCL	0x4001b8b1
                        MX6QDL_PAD_KEY_ROW3__I2C2_SDA	0x4001b8b1
                >;
        };

        pinctrl_i2c3: i2c3grp {
                fsl,pins = <
                        MX6QDL_PAD_GPIO_5__I2C3_SCL	0x4001b8b1
                        MX6QDL_PAD_GPIO_16__I2C3_SDA	0x4001b8b1
                >;
        };

	pinctrl_i2c1_recovery: i2c1recoverygrp {
                fsl,pins = <
			MX6QDL_PAD_CSI0_DAT9__GPIO5_IO27	0x4001b899
			MX6QDL_PAD_CSI0_DAT8__GPIO5_IO26	0x4001b899
                >;
        };

        pinctrl_i2c2_recovery: i2c2recoverygrp {
                fsl,pins = <
                        MX6QDL_PAD_KEY_COL3__GPIO4_IO12		0x4001b899
                        MX6QDL_PAD_KEY_ROW3__GPIO4_IO13		0x4001b899
                >;
        };

        pinctrl_i2c3_recovery: i2c3recoverygrp {
                fsl,pins = <
			MX6QDL_PAD_GPIO_5__GPIO1_IO05		0x4001b899
			MX6QDL_PAD_GPIO_16__GPIO7_IO11		0x4001b899
                >;
        };
};

&pwm1 {
    /* pincttrl set in ov7651 node */
    status = "okay";
};

/* eMMC */
&usdhc1 {
	vmmc-supply = <&reg_3p3v>; /* Supply voltage determined from part number */
	vqmmc-supply = <&reg_1p8v>; /* DDR52 speed support. Really connected to VGEN4 per SW-8715*/
};

/* SD card - only on early dev boards */
&usdhc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc2>;
	cd-gpios = <&gpio4 14 GPIO_ACTIVE_LOW>;
	wp-gpios = <&gpio4 15 GPIO_ACTIVE_HIGH>;
	no-1-8-v;
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_3p3v>; /* Assumed per no-1.8V property */
	keep-power-in-suspend;
	status = "okay";
};

/* Wireless Module
 * VIO Assumed based on WL1831 Datasheet
 * Commented out because there is a level shifter between,
 * so we're gonna get complaints from the kernel regardless
 */
/* &usdhc3 {
	vqmmc-supply = <&reg_1p8v>; 
}; */

/ {
    /* Buttons in the motherboard */
    leds {
        compatible = "gpio-leds";
        gp-41 {
            label = "fan";
            gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>;
            default-state = "on";
        };
    };
};

&pinctrl_hog {
            fsl,pins = <
                /* Turn on the fan: gpio41 out high */
		/* ./Documentation/devicetree/bindings/pinctrl/fsl,imx6q-pinctrl.txt */
                MX6QDL_PAD_SD4_DAT1__GPIO2_IO09         0x1b0b1
                
                /* Audio Clock */
                MX6QDL_PAD_GPIO_0__CCM_CLKO1            0x130b0

                /* RTC Pullup - GPIO 146 PAD_CTL_PUS_100K_UP | PAD_CTL_PUE | PAD_CTL_PKE | PAD_CTL_SPEED_MED | PAD_CTL_DSE_40ohm*/
                MX6QDL_PAD_CSI0_PIXCLK__GPIO5_IO18  0x0b0b0

                /* Disabled pins (Output low) - PAD_CTL_DSE_40ohm */
                MX6QDL_PAD_GPIO_1__GPIO1_IO01       0x38
                MX6QDL_PAD_GPIO_2__GPIO1_IO02       0x38
                MX6QDL_PAD_EIM_DA5__GPIO3_IO05      0x38
                MX6QDL_PAD_EIM_DA7__GPIO3_IO07      0x38

                /* MCU BOARD ID */
                MX6QDL_PAD_DISP0_DAT19__GPIO5_IO13 0x0001b8b0
                MX6QDL_PAD_DISP0_DAT22__GPIO5_IO16 0x0001b8b0
                MX6QDL_PAD_DISP0_DAT21__GPIO5_IO15 0x0001b8b0

                /* Audio reset */
                MX6QDL_PAD_GPIO_19__GPIO4_IO05		0x178b0

                /* Camera Clock */
                MX6QDL_PAD_GPIO_3__CCM_CLKO2		0x130b0

                /* Resistive touch irq */
                MX6QDL_PAD_DISP0_DAT4__GPIO4_IO25	0x178b0

                /* MCU Wake now Ready line, Open Drain input pulled high */
                MX6QDL_PAD_CSI0_MCLK__GPIO5_IO19	0x0001b8b0

                /* MCU INT, Open Drain, pulled high */
                MX6QDL_PAD_CSI0_DAT18__GPIO6_IO04	0x0001b8b0
            >;
};

/* Our Audio Codec is depopulated */
&audmux {
	status = "disabled";
};

/* Our Ethernet is depopulated */
&fec {
	status = "disabled";
};

/* Potential TODO: Audio code is setup in dtsi, but we don't have it */

&clks {
	assigned-clocks = <&clks IMX6QDL_CLK_LDB_DI0_SEL>,
			  <&clks IMX6QDL_CLK_LDB_DI1_SEL>;
	assigned-clock-parents = <&clks IMX6QDL_CLK_PLL2_PFD0_352M>,
				 <&clks IMX6QDL_CLK_PLL2_PFD0_352M>;
};

/* ttymxc2 UART */
&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart3>;
	fsl,uart-has-rtscts;
	status = "okay";
};

/* used for NAND Calibration File Storage and Recovery */
&gpmi {
	#address-cells = <1>;
	#size-cells = <1>;

        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_gpmi_nand>;
        fsl,legacy-bch-geometry;
        status = "okay";

        /* a 1012 MiB partition */
        partition@0 {
                label = "storage";
                reg = <0x00c00000 0x1f400000>;
        };
};

/* Jeremy thinks he put this in at some point, and probably for good reason. */
&usbotg {
	srp-disable;
	hnp-disable;
	adp-disable;
};

/* Disable the RTC section of the SoC - not used */
&snvs_rtc {
	status = "disabled";
};

/* No-Op Phys used for unused internal USB buses */
&usbphynop1 {
	status = "disabled";
};

&usbphynop2 {
	status = "disabled";
};
